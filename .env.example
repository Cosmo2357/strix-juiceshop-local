# このファイルを .env にコピーして、自分のプロバイダとキーを書いてください。
#   cp .env.example .env
# .env は .gitignore 済みなので Git には載りません。

# --- 使うプロバイダの行だけ有効にする ---

# Anthropic Claude の場合
STRIX_LLM="anthropic/claude-sonnet-4-5"
LLM_API_KEY="sk-ant-ここに自分のキー"

# OpenAI の場合（上をコメントアウトしてこちらを使う）
# STRIX_LLM="openai/gpt-5"
# LLM_API_KEY="sk-ここに自分のキー"

# ローカルモデル（Ollama / LMStudio）を使うときだけ
# LLM_API_BASE="http://host.docker.internal:11434"
